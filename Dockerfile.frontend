# Frontend image. Next.js standalone output: a minimal server.js plus only
# the node_modules it traced (next.config.ts: output "standalone").

# ── Build ────────────────────────────────────────────────────────────────────
FROM node:26-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# npm ci checks the lockfile against all workspaces, so all three manifests are copied.
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
RUN npm ci -w @css-atlas/shared -w @css-atlas/frontend

COPY shared/ shared/
COPY frontend/ frontend/

# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, and
# next.config.ts aliases NEXT_PUBLIC_BACKEND_URL from BACKEND_URL, so these
# must be present during `next build`.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ARG BACKEND_URL
ARG NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY \
    BACKEND_URL=$BACKEND_URL \
    NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL

RUN npm run build -w @css-atlas/shared -w @css-atlas/frontend

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:26-alpine AS runtime
WORKDIR /app
# HOSTNAME=0.0.0.0: the standalone server otherwise only listens inside the
# container. PORT comes from Railway at runtime (server.js defaults to 3000).
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0

# Owned by the unprivileged `node` user so Next can write its .next/cache.
COPY --from=build --chown=node:node /app/frontend/.next/standalone ./
COPY --from=build --chown=node:node /app/frontend/.next/static frontend/.next/static
COPY --from=build --chown=node:node /app/frontend/public frontend/public

USER node
EXPOSE 3000
CMD ["node", "frontend/server.js"]
