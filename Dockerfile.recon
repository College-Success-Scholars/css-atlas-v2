# ── Build stage — compiles `shared`, and installs backend deps via npm ──────
# npm only exists in this Node-based stage. The runner stage below is a Bun
# base image with no npm binary at all, which is why the install must happen
# here and be copied over, not re-run in the runner.
FROM node:22-alpine AS builder

WORKDIR /app

COPY shared/package.json ./shared/
RUN npm install --include=dev --prefix ./shared

COPY shared/ ./shared/
RUN npm run --prefix ./shared build
# Runtime images copy shared/ (package.json, dist, production node_modules).
RUN npm prune --omit=dev --prefix ./shared

# Install backend's PRODUCTION deps only, via npm — matching the backend
# image's installer exactly, and matching the signin cron's Dockerfile.
# Bun executes against npm-installed node_modules fine; it doesn't need to
# be the installer to be the runtime. See docs/notifications.md for why
# this was a deliberate choice.
COPY backend/package.json backend/package-lock.json ./backend/
RUN npm ci --omit=dev --prefix ./backend

# ── Runtime stage — Bun runs the detector's TypeScript directly, no tsc ─────
# This image has no npm/node — it only needs to execute already-installed
# node_modules and already-compiled shared/dist, both copied from builder.
FROM oven/bun:1-alpine AS runner

WORKDIR /app

# @css-atlas/shared is a file: dependency — node_modules/@css-atlas/shared is a
# symlink to /app/shared, so the package (manifest, dist, its own production
# deps) must exist at that path at runtime.
COPY --from=builder /app/shared/package.json ./shared/package.json
COPY --from=builder /app/shared/dist/ ./shared/dist/
COPY --from=builder /app/shared/node_modules/ ./shared/node_modules/

# Pre-installed by npm in the builder stage — not reinstalled here.
COPY --from=builder /app/backend/node_modules/ ./backend/node_modules/
COPY backend/package.json ./backend/

# Backend source, uncompiled — Bun transpiles TS on the fly for the whole
# import graph, not just the entry file, so no `npx tsc` step is needed here.
COPY backend/src/ ./backend/src/

# No secrets are baked into this image via ARG/ENV. SUPABASE_SERVICE_ROLE_KEY,
# SLACK_BOT_TOKEN, and NOTIFICATIONS_LAUNCH_DATE are set directly on the
# Railway service and injected at container start — keeping them out of
# image layers/history.

CMD ["bun", "run", "backend/src/domains/notifications/detectors/reconciliation-detector.ts"]