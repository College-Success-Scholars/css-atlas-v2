# Backend image. Runs the API by default (CMD below). The two notification
# crons use this same image; Railway overrides the start command per cron
# service (see .railway/railway.ts).

# ── Manifests: the one root lockfile + every workspace's package.json ────────
# npm ci checks the lockfile against all workspaces, so all three are copied
# even though only shared and backend get installed.
FROM node:26-alpine AS manifests
WORKDIR /app
# Puppeteer's postinstall would download Chrome; the runtime uses Alpine's chromium.
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/

# ── Build: all deps (tsc is a devDependency), compile shared then backend ────
FROM manifests AS build
RUN npm ci -w @css-atlas/shared -w @css-atlas/backend
COPY shared/ shared/
COPY backend/ backend/
RUN npm run build -w @css-atlas/shared -w @css-atlas/backend

# ── Production deps only ─────────────────────────────────────────────────────
FROM manifests AS prod-deps
RUN npm ci --omit=dev -w @css-atlas/shared -w @css-atlas/backend

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:26-alpine AS runtime

# Chromium for the weekly memo PDF. Alpine's package instead of Puppeteer's
# glibc download; launch also passes --disable-dev-shm-usage.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV NODE_ENV=production \
    PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
# node_modules/@css-atlas/shared is a workspace symlink to /app/shared.
COPY --from=prod-deps /app/node_modules node_modules
COPY --from=build /app/shared/package.json shared/
COPY --from=build /app/shared/dist shared/dist
COPY --from=build /app/backend/package.json /app/backend/.puppeteerrc.cjs backend/
COPY --from=build /app/backend/dist backend/dist

# Runtime config (SUPABASE_*, CORS_ORIGIN, secrets) is injected by Railway or
# docker compose at container start. Nothing is baked into the image.
WORKDIR /app/backend
EXPOSE 3001
CMD ["node", "dist/server.js"]
