# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# 1. Install shared devDeps (typescript) and compile shared
COPY shared/package.json ./shared/
RUN npm install --include=dev --prefix ./shared

COPY shared/ ./shared/
RUN npm run --prefix ./shared build

# 2. Install ALL backend deps (devDeps needed for tsc)
COPY backend/package.json backend/package-lock.json ./backend/
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN npm ci --prefix ./backend

# 3. Compile backend — run tsc directly so we skip the redundant shared rebuild
COPY backend/src/      ./backend/src/
COPY backend/tsconfig.json ./backend/
RUN cd backend && npx tsc

# ── Production stage ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

ARG SUPABASE_URL
ARG SUPABASE_PUBLISHABLE_KEY
ARG CORS_ORIGIN
ENV SUPABASE_URL=$SUPABASE_URL
ENV SUPABASE_PUBLISHABLE_KEY=$SUPABASE_PUBLISHABLE_KEY
ENV CORS_ORIGIN=$CORS_ORIGIN

WORKDIR /app

# shared/dist must be accessible at runtime — backend imports via relative path
# e.g. backend/dist/services/time.service.js -> ../../../shared/dist/time.js
COPY --from=builder /app/shared/dist/ ./shared/dist/

# Compiled backend
COPY --from=builder /app/backend/dist/ ./backend/dist/

# Chromium for weekly memo PDF. Skip Puppeteer's Chrome download (glibc
# binary) and use Alpine's package instead. Launch also uses
# --disable-dev-shm-usage because container /dev/shm is often 64MB.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Production-only deps
COPY backend/package.json backend/package-lock.json backend/.puppeteerrc.cjs ./backend/
RUN npm ci --omit=dev --prefix ./backend

EXPOSE 3001
CMD ["node", "/app/backend/dist/server.js"]
