# Required — Supabase project credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# Required by notification cron jobs only. Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SLACK_BOT_TOKEN=xoxb-<bot-token>
NOTIFICATIONS_LAUNCH_DATE=YYYY-MM-DD

# Optional notification operating defaults
SIGNIN_NOTIFICATION_LATE_THRESHOLD_MINUTES=25
SIGNIN_NOTIFICATION_RECONCILIATION_DAYS=7
SLACK_NOTIFICATION_MAX_ATTEMPTS=3

# Optional — defaults to 3001
PORT=3001

# CORS: comma-separated list of allowed frontend origins
# Dev default: http://localhost:3002
# Production example: https://yourapp.vercel.app,https://yourapp.railway.app
CORS_ORIGIN=http://localhost:3002
