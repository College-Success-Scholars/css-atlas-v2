{
  "name": "@css-atlas/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "start:signin-detector": "node dist/domains/notifications/detectors/signin-detector.js",
    "start:reconciliation-detector": "node dist/domains/notifications/detectors/reconciliation-detector.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:chrome": "puppeteer browsers install chrome",
    "db:types": "./scripts/gen-db-types.mjs",
    "lint": "eslint",
    "lint:baseline": "node ../tools/lint-baseline.mjs --check",
    "deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "deps:baseline": "depcruise-baseline src --config .dependency-cruiser.cjs",
    "guardrails": "npm run lint && npm run lint:baseline && npm run deps",
    "routes": "tsx scripts/route-inventory.ts"
  },
  "dependencies": {
    "@css-atlas/shared": "*",
    "@fontsource/archivo": "5.3.0",
    "@supabase/supabase-js": "^2.104.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "effect": "~4.1.2",
    "express": "^5.2.1",
    "puppeteer": "^25.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.4"
  }
}
