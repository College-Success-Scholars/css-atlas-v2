{
  "name": "css-atlas-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:rewrite-links": "node scripts/docs-rewrite-links.mjs",
    "docs:copy-api": "node scripts/docs-copy-api-md.mjs",
    "docs:typedoc": "rm -rf docs/reference/api && typedoc --options typedoc.json",
    "docs:append-api": "node scripts/docs-append-api-indexes.mjs",
    "docs:coverage": "node scripts/check-docs-api-coverage.mjs",
    "docs:prepare": "npm run docs:copy-api && npm run docs:rewrite-links && npm run docs:typedoc && npm run docs:append-api",
    "docs:build": "npm run docs:prepare && mkdocs build",
    "docs:serve": "npm run docs:prepare && mkdocs serve",
    "push:staging": "supabase link --project-ref xhcnncsgxrgxwmgjhbnz && supabase db push",
    "push:prod": "supabase link --project-ref qclgoapaleomceugftre && supabase db push",
    "link:staging": "supabase link --project-ref xhcnncsgxrgxwmgjhbnz",
    "link:prod": "supabase link --project-ref qclgoapaleomceugftre",
    "audit:staging": "supabase migration list --project-ref xhcnncsgxrgxwmgjhbnz",
    "audit:prod": "supabase migration list --project-ref qclgoapaleomceugftre"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "shared": "^0.2.0"
  },
  "devDependencies": {
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
