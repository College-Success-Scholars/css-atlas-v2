{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        ".railway/railway.ts",
        "scripts/*.mjs",
        "tools/**/*.mjs"
      ],
      "project": [
        ".railway/**/*.ts",
        "scripts/**/*.mjs",
        "tools/**/*.mjs"
      ]
    },
    "shared": {
      "entry": [
        "*.ts",
        "contracts/**/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "backend": {
      "entry": [
        "src/server.ts",
        "src/domains/notifications/detectors/*-detector.ts",
        "src/domains/notifications/__manual_test__/*.ts",
        "scripts/**/*.{ts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.{ts,mjs}"
      ]
    },
    "frontend": {
      "entry": [
        "scripts/**/*.mjs",
        "scripts/fixtures/tier-navigation.tsx",
        "*.d.ts"
      ],
      "project": [
        "**/*.{ts,tsx,mjs}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css"
      ]
    }
  },
  "ignoreBinaries": [
    "supabase",
    "mkdocs"
  ]
}
